# ─────────────────────────────────────────────────────────────────────────────
# Contentful environment variables
#
# Copy this file to .env.local and fill in your values.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Found in Contentful → Settings → API Keys → Space ID
VITE_CONTENTFUL_SPACE_ID=your_space_id_here

# Found in Contentful → Settings → API Keys → Content Delivery API - access token
VITE_CONTENTFUL_ACCESS_TOKEN=your_delivery_access_token_here

# Only needed to run the migration script (not used by the app itself)
# Found in Contentful → Settings → API Keys → Content Management API tokens
# CONTENTFUL_MANAGEMENT_TOKEN=your_management_token_here
